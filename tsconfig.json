{
  "compilerOptions": {
    "module": "esnext",
    "skipLibCheck": true,
    "target": "es2022",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "sourceMap": true
  },
  "types": [
    "jest"
  ],
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
